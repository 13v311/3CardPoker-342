<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.uic.cs342.poker.controller.ResultsController"
      stylesheets="@../css/results.css">

    <VBox minWidth="380.0" minHeight="380.0">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        <VBox spacing="15" alignment="CENTER" prefHeight="380.0" prefWidth="380.0" minWidth="380.0" minHeight="380.0">
            <HBox spacing="7" alignment="CENTER">
                <Label fx:id="playerLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Wins" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>
            <Label text="How they won" alignment="CENTER"/>

            <HBox alignment="CENTER">
                <VBox spacing="10" style="-fx-background-color: -box-bg; ">
                    <Label text="Player 1" style="-fx-font-weight: bold;"/>
                    <Label fx:id="decisionLabel1"/>
                    <HBox>
                        <Label text="Ante:"/>
                        <Label fx:id="anteLabel1"/>
                    </HBox>
                    <HBox>
                        <Label text="Play:"/>
                        <Label fx:id="playLabel1"/>
                    </HBox>
                    <HBox>
                        <Label text="Pair Plus:"/>
                        <Label fx:id="ppLabel1"/>
                    </HBox>

                    <HBox spacing="7" alignment="CENTER">
                        <Label text="Total:"/>
                        <Label fx:id="totalLabel1"/>
                    </HBox>


                </VBox>
                <VBox spacing="10" style="-fx-background-color: -box-bg;">
                    <Label text="Player 2" style="-fx-font-weight: bold;"/>
                    <Label fx:id="decisionLabel2"/>
                    <HBox>
                        <Label text="Ante:"/>
                        <Label fx:id="anteLabel2"/>
                    </HBox>
                    <HBox>
                        <Label text="Play:"/>
                        <Label fx:id="playLabel2"/>
                    </HBox>
                    <HBox>
                        <Label text="Pair Plus:"/>
                        <Label fx:id="ppLabel2"/>
                    </HBox>

                    <HBox alignment="CENTER" spacing="7">
                        <Label text="Total:"/>
                        <Label fx:id="totalLabel2"/>
                    </HBox>

                </VBox>
            </HBox>

            <HBox alignment="CENTER" spacing="5">
                <Button fx:id="continueButton" text="Continue" styleClass="primary-button" onAction="#continueGame"/>
                <Button fx:id="menuButton" text="Menu" styleClass="secondary-button" onAction="#switchToMenu"/>
            </HBox>
        </VBox>
    </VBox>

</VBox>
