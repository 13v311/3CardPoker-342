<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.uic.cs342.poker.controller.ResultsController"
      stylesheets="@../css/results.css">

    <VBox minWidth="650.0" minHeight="600.0">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        <VBox spacing="20" alignment="CENTER" prefHeight="550.0" prefWidth="600.0" minWidth="600.0" minHeight="550.0">
            <HBox spacing="7" alignment="CENTER">
                <Label fx:id="playerLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label fx:id = "winner" text="Wins" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>
            <Label fx:id="winnerHow" text="How they won" alignment="CENTER"/>

            <HBox alignment="CENTER">
                <!-- Player 1 -->
                <VBox spacing="15"
                      alignment="CENTER"
                      prefWidth="250"
                      minHeight="240"
                      styleClass="player-card">

                    <Label text="Player 1" styleClass="player-title"/>
                    <Label fx:id="decisionLabel1" styleClass="decision-label"/>

                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Ante:"/>
                        <Label fx:id="anteLabel1"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Play:"/>
                        <Label fx:id="playLabel1"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Pair Plus:"/>
                        <Label fx:id="ppLabel1"/>
                    </HBox>

                    <Separator/>

                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Total:" styleClass="total-label"/>
                        <Label fx:id="totalLabel1" styleClass="total-label"/>
                    </HBox>

                </VBox>

                <!-- Player 2 -->
                <VBox spacing="15"
                      alignment="CENTER"
                      prefWidth="250"
                      minHeight="240"
                      styleClass="player-card">

                    <Label text="Player 2" styleClass="player-title"/>
                    <Label fx:id="decisionLabel2" styleClass="decision-label"/>

                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Ante:"/>
                        <Label fx:id="anteLabel2"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Play:"/>
                        <Label fx:id="playLabel2"/>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Pair Plus:"/>
                        <Label fx:id="ppLabel2"/>
                    </HBox>

                    <Separator/>

                    <HBox spacing="10" alignment="CENTER">
                        <Label text="Total:" styleClass="total-label"/>
                        <Label fx:id="totalLabel2" styleClass="total-label"/>
                    </HBox>

                </VBox>

            </HBox>

            <HBox alignment="CENTER" spacing="5">
                <Button fx:id="continueButton" text="Continue" styleClass="primary-button" onAction="#continueGame"/>
                <Button fx:id="menuButton" text="Menu" styleClass="secondary-button" onAction="#switchToMenu"/>
            </HBox>
        </VBox>
    </VBox>

</VBox>
